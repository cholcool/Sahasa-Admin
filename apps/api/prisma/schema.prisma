// Sahasa Admin — Prisma schema (MariaDB 11.8 on Hostinger)
// Source of truth: "Project Detail.xlsx" › sheet "Database" (kept outside git, ask cholcool).
//
// Rules used in every model:
// - Tables/columns are snake_case in the DB (@@map / @map), camelCase in TS
// - Ids are BIGINT UNSIGNED AUTO_INCREMENT (TS type: bigint)
// - Money is Decimal(12,2); never use float
// - DATETIME(3) stores UTC; DATE columns hold the Thai business date (YYYY-MM-DD)
// - Charset/collation: utf8mb4 / utf8mb4_unicode_ci (Prisma writes it on every CREATE TABLE)
//
// Audit columns (created_by / updated_by / deleted_by) are plain ids without a FK
// relation: a relation would add ~100 back-relation fields to User. Business FKs to
// users (confirmed_by, verified_by, …) are real relations.
//
// Unique keys on soft-deleted tables (users, roles, products, price_groups, customers)
// are plain UNIQUE: a soft-deleted row keeps its code. To reuse an email/username, the
// service rewrites the value on delete (e.g. "name~deleted~<id>").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ───────────────────────── Enums ─────────────────────────

