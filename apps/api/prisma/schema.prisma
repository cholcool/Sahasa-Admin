  NOVAT
}

enum ProductKind {
  tofu
  sauce
  other
}

enum CustomerType {
  person
  company
}

enum DeliveryRoundStatus {
  open
  locked
  shipped
}

enum OrderSource {
  manual
  upload
  api
}

