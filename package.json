{
  "name": "sahasa-admin",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sahasa/api --filter @sahasa/web dev",
    "build": "pnpm --filter @sahasa/shared build && pnpm --filter @sahasa/web build && pnpm --filter @sahasa/api build",
    "start": "pnpm --filter @sahasa/api start:prod",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "storybook": "pnpm --filter @sahasa/web storybook",
    "lint:fix": "oxlint --type-aware --fix"
  },
  "devDependencies": {
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines",
      "esbuild",
      "@swc/core"
    ]
  }
}
