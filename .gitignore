# Dependencies
node_modules/

# Build output
dist/
build/
storybook-static/
*.tsbuildinfo

# Generated (Prisma Client is regenerated by `prisma generate`)
apps/api/src/generated/

# TanStack cache (auto-generated per app)
/apps/web/.tanstack/
/apps/api/.tanstack/

# Test output
coverage/
test-results/
playwright-report/
**/__screenshots__/

# Environment / secrets (keep the example)
.env
.env.*
!.env.example

# Customer data — real names, addresses, phone numbers and slips. Never commit.
_requirements/Documents/
_requirements/Marketplace Order/
# Safety net: spreadsheets/exports anywhere under _requirements/
_requirements/**/*.xlsx
_requirements/**/*.xls
_requirements/**/*.csv
uploads/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Personal Claude settings (team rules live in CLAUDE.md)
CLAUDE.local.md
.claude/settings.local.json

# OS / editor
.DS_Store
~$*
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
